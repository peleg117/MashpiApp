# פורט השרת
PORT=3000

# קובץ מסד הנתונים (SQLite)
DB_PATH=./data/mashpiapp.db

# טוקן מנהל — אם מוגדר, פעולות כתיבה (הוספה/עריכה/מחיקה/ייבוא) דורשות אותו
ADMIN_TOKEN=

# כל כמה שניות מנגנון הסנכרון רץ, וכמה פרופילים מעדכנים בכל סבב
SYNC_INTERVAL_SECONDS=60
SYNC_BATCH_SIZE=10
# פרופיל נחשב "ישן" ומועמד לעדכון אחרי X דקות
SYNC_STALE_MINUTES=360

# מילוי נתוני דמו בהפעלה ראשונה (true/false)
SEED_DEMO_DATA=true

# --- מקורות נתונים אמיתיים ---
# YouTube Data API v3
YOUTUBE_API_KEY=

# Instagram Graph API (Business Discovery) — דורש חשבון אינסטגרם עסקי/קריאייטור מחובר לדף פייסבוק
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok Research API (דורש אישור גישה מטיקטוק)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
